# FocusQuest Environment Variables

# App Environment
DEBUG=True
SECRET_KEY=focusquest_super_secret_development_key_change_in_prod

# PostgreSQL & pgvector Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=focusquest

# Optional Direct Database URL override (e.g. Supabase, Neon)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Vector Dimension (Default: 1536 for OpenAI/general models, 768 for Gemini text-embedding-004)
VECTOR_DIMENSION=1536

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Supabase Auth (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# LLM Providers (Add your active key)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

