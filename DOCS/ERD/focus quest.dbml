// FocusQuest Database Schema (DBML)
// Docs: https://dbml.dbdiagram.io/docs

Enum growth_stage {
  egg
  hatchling
  juvenile
  adult
}

Enum pet_mood {
  happy
  neutral
  sad
  hungry
}

Enum quest_difficulty {
  easy
  medium
  hard
  extreme
  extreme_final_boss
}

Enum quest_status {
  incomplete
  done
}

Enum quest_priority {
  low
  medium
  high
  critical
  critical_final_boss
}

Enum focus_session_status {
  started
  paused
  completed
  cancelled
}

Enum distraction_action {
  parked
  converted_to_quest
  dismissed
}

Enum memory_source_type {
  diary
  focus_habit
  coping_strategy
  preference
}

Table users {
  user_id uuid [pk, default: `uuid_generate_v4()`]
  username varchar(50) [unique, not null]
  email varchar(255) [unique, not null]
  password_hash varchar(255) [not null]
  age integer
  avg_speed_per_click float
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table pets {
  pet_id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [not null, ref: > users.user_id]
  pet_name varchar(50) [not null]
  growth_stage growth_stage [not null, default: 'egg']
  food_type varchar(50)
  pet_age integer
  pet_mood pet_mood [not null, default: 'neutral']
  current_xp integer [not null, default: 0]
}

Table quests {
  quest_id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [not null, ref: > users.user_id]
  parent_quest_id uuid [ref: > quests.quest_id]
  title varchar(255) [not null]
  description text
  difficulty_level quest_difficulty [not null, default: 'easy']
  xp_assigned integer [not null, default: 0]
  estimated_duration_minutes integer
  deadline_timestamp timestamp
  status quest_status [not null, default: 'incomplete']
  priority quest_priority [not null, default: 'medium']
  tags json
  is_micro_task boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table focus_sessions {
  session_id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [not null, ref: > users.user_id]
  quest_id uuid [ref: > quests.quest_id]
  duration_minutes integer [not null, default: 25]
  actual_duration_seconds integer [not null, default: 0]
  status focus_session_status [not null, default: 'started']
  distraction_count integer [not null, default: 0]
  xp_awarded integer [not null, default: 0]
  started_at timestamp [not null, default: `now()`]
  ended_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table distraction_logs {
  log_id uuid [pk, default: `uuid_generate_v4()`]
  session_id uuid [ref: > focus_sessions.session_id]
  user_id uuid [not null, ref: > users.user_id]
  thought_content text [not null]
  action_taken distraction_action [not null, default: 'parked']
  created_at timestamp [not null, default: `now()`]
}

Table diary_entries {
  entry_id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [not null, ref: > users.user_id]
  mood_score integer [not null, default: 3]
  mood_tags json
  raw_text text [not null]
  ai_reflection text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table agent_memory {
  memory_id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [not null, ref: > users.user_id]
  source_type memory_source_type [not null, default: 'diary']
  source_id uuid
  content text [not null]
  embedding vector(1536) [not null, note: 'HNSW Cosine Vector Index']
  metadata_json json
  created_at timestamp [not null, default: `now()`]
}

Table map_nodes {
  node_id integer [pk, increment]
  zone_id integer [not null, default: 1]
  title varchar(100) [not null]
  description text
  required_xp integer [not null, default: 0]
  order_index integer [not null, default: 0]
  rewards_json json
  created_at timestamp [not null, default: `now()`]
}

Table user_map_progression {
  progression_id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [not null, ref: > users.user_id]
  node_id integer [not null, ref: > map_nodes.node_id]
  is_unlocked boolean [not null, default: false]
  is_completed boolean [not null, default: false]
  unlocked_at timestamp
  completed_at timestamp
}
